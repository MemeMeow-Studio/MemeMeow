{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python 调试程序: 当前文件",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal"
    },
    {
      "name": "Python: FastAPI server",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "api:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8275"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
