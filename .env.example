# MemeMeow 服务端配置。复制为 .env 后填写，密钥不会返回给前端。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
LLM_ENHANCE_MODEL=

# OpenCode 必须由部署环境预先安装。runtime 会写入无密钥的通用 opencode.json。
MEMEMEOW_OPENCODE_EXECUTABLE=opencode
MEMEMEOW_OPENCODE_BASE_URL=
MEMEMEOW_OPENCODE_API_KEY=
# 模型由命令行 --model 传递；当前通用配置只注册此模型，研究任务固定使用 max 推理变体。
MEMEMEOW_OPENCODE_MODEL=mememeow/gpt-5.6-luna
MEMEMEOW_OPENCODE_RUNTIME_ROOT=./data/opencode
MEMEMEOW_OPENCODE_TIMEOUT_SECONDS=1800
MEMEMEOW_OPENCODE_MAX_OUTPUT_BYTES=2097152
# Agent lane 并发上限，安全范围 1..8；默认 1，修改后重启服务生效。
MEMEMEOW_OPENCODE_CONCURRENCY=1
MEMEMEOW_AGENT_BACKPRESSURE=32
# 设置页更新凭据；留空时设置 API 只读。
MEMEMEOW_SETTINGS_ADMIN_TOKEN=
# 指向预装 OpenCode 插件依赖；留空时使用项目根目录 .opencode/node_modules。
MEMEMEOW_OPENCODE_NODE_MODULES=./.opencode/node_modules

# SerpApi Google Lens 图片检索，可选；仅服务端和 Agent 运行环境读取。
SERPAPI_API_KEY=
MEMEMEOW_REVERSE_IMAGE_CACHE_ROOT=./data/reverse_image_cache/serpapi_google_lens

MEMEMEOW_DATA_ROOT=./data
MEMEMEOW_IMAGE_ROOT=./data/images
MEMEMEOW_MAX_UPLOAD_SIZE=20971520

MEMEMEOW_PROTECTED_MODE=false
MEMEMEOW_ALLOWED_ENDPOINTS=/,/health,/search,/config,/backend/settings,/tasks,/generate-cache,/images,/media
MEMEMEOW_RATE_LIMIT_ENABLED=false
MEMEMEOW_RATE_LIMIT_REQUESTS=60
MEMEMEOW_RATE_LIMIT_WINDOW=60
