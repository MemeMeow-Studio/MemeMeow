# MemeMeow 服务端配置。复制为 .env 后填写，密钥不会返回给前端。
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
LLM_ENHANCE_MODEL=

VLM_API_KEY=
VLM_BASE_URL=https://api.siliconflow.cn/v1
VLM_MODEL=Qwen/Qwen2-VL-72B-Instruct
VLM_MAX_ATTEMPTS=2

# SerpApi Google Lens 图片检索，可选；仅服务端和 Agent 运行环境读取。
SERPAPI_API_KEY=

MEMEMEOW_DATA_ROOT=./data
MEMEMEOW_IMAGE_ROOT=./data/images
MEMEMEOW_MAX_UPLOAD_SIZE=20971520

MEMEMEOW_PROTECTED_MODE=false
MEMEMEOW_ALLOWED_ENDPOINTS=/,/health,/search,/config,/tasks,/generate-cache,/images,/media
MEMEMEOW_RATE_LIMIT_ENABLED=false
MEMEMEOW_RATE_LIMIT_REQUESTS=60
MEMEMEOW_RATE_LIMIT_WINDOW=60
